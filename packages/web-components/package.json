  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demi-sh/demi.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/demi-sh/demi/tree/main/packages/web-components#readme",
  "bugs": "https://github.com/demi-sh/demi/issues"
