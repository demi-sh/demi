{
  "extends": ["../../tsconfig.json", "@vue/tsconfig/tsconfig.dom.json"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "paths": {
      "@jush-ai/web-ui/*": ["../web-ui/src/*"],
      "@jush-ai/*": ["../*/src/index.ts", "../../crates/*/page/src/index.ts"]
