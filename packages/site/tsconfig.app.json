{
  "extends": [
    "../../tsconfig.json",
    "@vue/tsconfig/tsconfig.dom.json"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "bun"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@jush-ai/web-ui/*": [
        "../web-ui/src/*"
      ],
      "@jush-ai/web-gallery/*": [
        "../web-gallery/src/*"
      ],
      "@jush-ai/plugin-browser/*": [
        "../../crates/plugin-browser/page/src/*"
      ],
      "@jush-ai/plugin-mobile/*": [
        "../../crates/plugin-mobile/page/src/*"
      ],
      "@jush-ai/plugin-changes/*": [
        "../../crates/plugin-changes/page/src/*"
      ],
      "@jush-ai/plugin-file-browser/*": [
        "../../crates/plugin-file-browser/page/src/*"
      ],
      "@jush-ai/plugin-skills/*": [
        "../../crates/plugin-skills/page/src/*"
      ],
      "@jush-ai/plugin-web/*": [
        "../../crates/plugin-web/page/src/*"
      ],
      "@jush-ai/*": [
        "../*/src/index.ts",
        "../../crates/*/page/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "record"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
