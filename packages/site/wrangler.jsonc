// The site on Cloudflare: a Worker that only serves `dist/`, at jush.ai.
// `bun run deploy` publishes the last build; .github/workflows/site.yml builds
// and publishes after each push to main.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jush-site",
  "compatibility_date": "2026-10-28",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "jush.ai", "custom_domain": true }],
  "workers_dev": false
}
