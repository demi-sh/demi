# Local secrets for real-provider harnesses (never commit)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Development account: `bun xtask dev` (`bun run dev`) seeds it as the
# first user on every start, and the web application's sign-in page fills it
# in during development (packages/web/vite.config.ts); both or neither
JUSH_DEV_EMAIL=
JUSH_DEV_PASSWORD=

# A real model the development backend adds beside Echo, over an
# OpenAI-compatible Chat Completions endpoint; all four or none
# (`crates/xtask/src/dev/mod.rs`). `bun run dev`
# loads this file.
JUSH_DEV_PROVIDER_BASE_URL=
JUSH_DEV_PROVIDER_API_KEY=
JUSH_DEV_PROVIDER_MODEL=
JUSH_DEV_PROVIDER_CONTEXT_WINDOW=
# Optional: the model's thinking efforts as the endpoint names them, such as
# low,medium,high; without it the page offers no effort.
JUSH_DEV_PROVIDER_THINKING_EFFORTS=
# Optional: the file types the model reads natively, such as
# png,jpg,jpeg,gif,webp for a model that reads images; without it no file
# reaches the model natively.
JUSH_DEV_PROVIDER_ACCEPTED_EXTENSIONS=

# The Codex CLI's sign-in, such as ~/.codex/auth.json: the development backend
# makes its Codex entry hold that account, without its refresh token, so the
# CLI's own sign-in stays valid; once its access token expires, run
# `codex login` and start again.
JUSH_DEV_CODEX_AUTH=

# 1 adds the echo model, which answers each message with "Echo: <message>"
# without calling any vendor; off when unset.
JUSH_DEV_ECHO=

# Cloud: the machine manager on this Linux machine (`crates/xtask/src/dev/mod.rs`)
# JUSH_MACHINE_MANAGER_SOCKET=/run/jush-cloud/machines.sock
# JUSH_BACKEND_PUBLIC_URL=http://<address the Cloud guest reaches>:3271
# On a Mac with Lima (docs/guides/mac-development.md):
# JUSH_MACHINE_MANAGER_SOCKET=/Users/me/.lima/jush-machine-manager/sock/jush-machine-manager.sock
