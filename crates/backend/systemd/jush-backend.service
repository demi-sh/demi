# The backend's unit, which a server release carries in its systemd/
# (`crates/server/src/main.rs`).
#
# - It runs the release /opt/jush/current points to, as the system user jush,
#   whose jush-cloud group reaches the machine manager's socket, with only the
#   capability to listen on a port below 1024, as behind Cloudflare.
# - It serves its Clouds' runners on /run/jush-backend/runners.sock, whose
#   directory outlives its restarts: each Cloud has the directory mounted, so
#   the socket a restarted backend makes again reaches it.
# - Type=notify: the backend reports readiness once it listens, after its
#   migrations, which have no deadline; nor has its shutdown, which saves every
#   Cloud.
[Unit]
Description=Jush backend
After=network-online.target jush-machine-manager.service
Wants=network-online.target jush-machine-manager.service

[Service]
Type=notify
User=jush
Group=jush
SupplementaryGroups=jush-cloud
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077
RuntimeDirectory=jush-backend jush-backend-manage jush-upgrade
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=infinity
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=3
EnvironmentFile=/opt/jush/config/jush.env
Environment=JUSH_UPGRADE_REQUEST=/run/jush-upgrade/version
ExecStart=/opt/jush/current/bin/jush-backend

[Install]
WantedBy=multi-user.target
