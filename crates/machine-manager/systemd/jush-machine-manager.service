# The Cloud machine manager's unit, which a server release carries in its
# systemd/ (docs/cloud/setup.md § Storage and service setup). It runs the
# release /opt/jush/current points to.
#
# - Type=notify: the manager reports readiness once it has recovered, installed
#   its network policy, imported its base and opened its socket. None of that,
#   nor a stop's drain and its recovery, has a deadline.
# - KillMode=process signals the manager alone and ends nothing else of the
#   unit, as containerd's unit does: a manager an upgrade asks to leave its
#   running Clouds exits with their sandboxes running, which the next manager
#   takes over (crates/machine-manager/src/handover.rs). A manager that stops
#   otherwise stops and saves its sandboxes itself, and the next one ends what
#   the unit still holds that no sandbox owns.
[Unit]
Description=Jush Cloud machine manager
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=root
Group=jush-cloud
PrivateMounts=yes
UMask=0077
KillMode=process
TimeoutStartSec=infinity
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=3
RuntimeDirectory=jush-cloud
RuntimeDirectoryMode=0750
EnvironmentFile=/opt/jush/config/jush.env
Environment=JUSH_SERVICE_MANAGER=systemd
ExecStart=/opt/jush/current/bin/jush-machine-manager
ExecStopPost=/opt/jush/current/bin/jush-machine-manager --recover

[Install]
WantedBy=multi-user.target
